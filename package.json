{
  "name": "secure-digital-notice-board",
  "version": "1.0.0",
  "description": "Secure Digital Notice Board - Secure Software Engineering Laboratory Evaluation",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "lint": "npm --prefix backend run lint",
    "audit": "npm --prefix backend audit && npm --prefix frontend audit",
    "test": "./backend/node_modules/.bin/tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/e2e/*.test.ts tests/security/*.test.ts",
    "test:unit": "./backend/node_modules/.bin/tsx --test tests/unit/*.test.ts",
    "test:integration": "./backend/node_modules/.bin/tsx --test tests/integration/*.test.ts",
    "test:e2e": "./backend/node_modules/.bin/tsx --test tests/e2e/*.test.ts",
    "test:security": "./backend/node_modules/.bin/tsx --test tests/security/*.test.ts",
    "test:fuzz": "./backend/node_modules/.bin/tsx tests/fuzzing/fuzz_inputs.ts",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "docker:db": "docker compose up -d postgres"
  },
  "keywords": [
    "secure-software-engineering",
    "rbac",
    "threat-modeling",
    "audit-logging",
    "notice-board"
  ],
  "author": "",
  "license": "ISC"
}
