# ====================================================================
# Secure Digital Notice Board - Environment Configuration
# ====================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=replace_with_secure_database_password
DB_NAME=digital_notice_board
DB_SSL=false

# Authentication Secrets (Generate strong random 64-char strings for production)
JWT_SECRET=replace_with_at_least_32_char_cryptographically_secure_random_secret
JWT_EXPIRES_IN=1h

# CORS Configuration (Strict client origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=100
