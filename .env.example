# ====================================================================
# Secure Digital Notice Board - Environment Configuration
# ====================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass_123
DB_NAME=digital_notice_board
DB_SSL=false

# Authentication Secrets (Generate strong random 64-char strings for production)
JWT_SECRET=super_secret_jwt_key_for_notice_board_sse_lab_exam_2026_at_least_32_chars
JWT_EXPIRES_IN=1h

# CORS Configuration (Strict client origin)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
